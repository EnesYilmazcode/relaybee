# Generate both with: npm run secrets
# Mark both Sensitive in the Vercel dashboard. Use distinct values per environment.

# Signs Relaybee API keys (HMAC-SHA256).
MASTER_SECRET=

# Seals provider connections (AES-256-GCM). Must decode to exactly 32 bytes.
MASTER_ENCRYPTION_KEY=

# Required on Vercel and other multi-instance/serverless production deployments.
# Local development falls back to an in-memory queue. Production fails closed if
# either value is absent, because a per-instance queue loses jobs when the caller
# and worker land on different edge isolates. Create a free database at upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set this to 1 on any non-Vercel serverless host to require shared queue state.
RELAYBEE_REQUIRE_DISTRIBUTED_QUEUE=
